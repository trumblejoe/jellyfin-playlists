using Xunit;

namespace JellyfinPlaylists.Tests;

public sealed class PlaylistCatalogTests
{
    [Fact]
    public void DefaultTargets_IncludesPriorityPlaylists()
    {
        var targets = PlaylistCatalog.HighPriorityTargets;

        Assert.Contains(targets, target => target.Name.Contains("Arrowverse", StringComparison.OrdinalIgnoreCase));
        Assert.Contains(targets, target => target.Name.Contains("Marvel", StringComparison.OrdinalIgnoreCase));
    }

    [Fact]
    public void NormalizeName_HandlesPunctuationAndCase()
    {
        var normalized = PlaylistMatchHelper.NormalizeName("The Flash - 2014");

        Assert.Equal("the flash 2014", normalized);
    }

    [Fact]
    public void VideoFilter_IgnoresMusic()
    {
        var items = new[]
        {
            new LibraryItemRecord(
                "movie-1",
                "The Avengers",
                "The Avengers",
                LibraryItemType.Movie,
                null,
                null,
                "/media/movies/the-avengers.mkv",
                "2012-05-04",
                null,
                null,
                null,
                ["Action"]),
            new LibraryItemRecord(
                "music-1",
                "The Soundtrack",
                "The Soundtrack",
                LibraryItemType.Music,
                null,
                null,
                "/media/music/the-soundtrack.mp3",
                null,
                null,
                null,
                null,
                ["Rock"]) 
        };

        var filtered = LibraryItemFilters.FilterVideoLibrary(items).ToArray();

        Assert.Single(filtered);
        Assert.Equal(LibraryItemType.Movie, filtered[0].ItemType);
    }
}
